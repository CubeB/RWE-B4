#!/usr/bin/env python3
"""Fake ai_arena for runner tests.

Emulates the engine's observable contract without the engine: parses --out and
--log, sleeps briefly, writes ai-arena.csv, ai-arena-events.csv, game.log (with
an AI-ARENA-RESULT line) and run.json. Environment switches let a test drive it
into each status the runner records:

    FAKE_ARENA_SLEEP     seconds to sleep before writing (default 0.05)
    FAKE_ARENA_CSV       copy this CSV to --out/ai-arena.csv (default: a
                         minimal healthy table is generated)
    FAKE_ARENA_RUN_JSON  "0" to omit run.json
    FAKE_ARENA_NO_RESULT "1" to omit the AI-ARENA-RESULT line
    FAKE_ARENA_EXIT      process exit code (default 0)

Never used outside tests; the real runner points --binary at build/ai_arena.
"""

import os
import shutil
import sys
import time
from pathlib import Path

HEADER = (
    "tick,seconds,player,side,status,metal,energy,maxMetal,maxEnergy,"
    "metalIncome,energyIncome,metalDemand,energyDemand,"
    "units,buildings,army,builders,unitsLost,buildingsLost,"
    "idleBuilders,factories,idleFactories,armyMetal,"
    "metalProduced,metalExcess,energyProduced,energyExcess,phase\n"
)


def arg(name, default=None):
    argv = sys.argv
    for i, value in enumerate(argv):
        if value == name and i + 1 < len(argv):
            return argv[i + 1]
        if value.startswith(name + "="):
            return value.split("=", 1)[1]
    return default


def minimal_csv():
    rows = [HEADER]
    for tick in range(0, 910, 10):
        seconds = tick // 10
        for player, side in ((0, "ARM"), (1, "CORE")):
            metal = 500.0
            max_metal = 1000.0
            income = 2.0 + player * 0.1
            produced = 100.0 * seconds
            rows.append(
                f"{tick},{seconds},{player},{side},alive,{metal},3000.0,{max_metal},5000.0,"
                f"{income},50.0,1.0,10.0,10,5,4,2,0,0,0,1,0,100.0,"
                f"{produced},0.0,{produced * 10},0.0,mid\n"
            )
    return "".join(rows)


def main():
    time.sleep(float(os.environ.get("FAKE_ARENA_SLEEP", "0.05")))

    out = Path(arg("--out", "."))
    out.mkdir(parents=True, exist_ok=True)
    log_path = Path(arg("--log", str(out / "game.log")))
    log_path.parent.mkdir(parents=True, exist_ok=True)

    template = os.environ.get("FAKE_ARENA_CSV")
    if template:
        shutil.copyfile(template, out / "ai-arena.csv")
    else:
        (out / "ai-arena.csv").write_text(minimal_csv())

    (out / "ai-arena-events.csv").write_text(
        "player,unitType,category,isBuilding,startedTick,startedSeconds,"
        "completedTick,completedSeconds,diedTick,diedSeconds,"
        "x,z,enemiesNear,nearestEnemyType,friendlyArmyNear,friendlyTowersNear\n"
    )

    log_lines = ["AI arena: fake harness"]
    if os.environ.get("FAKE_ARENA_NO_RESULT") != "1":
        log_lines.append("AI-ARENA-RESULT ticks=9000 seconds=900 | p0=ARM alive units=10 | p1=CORE alive units=10")
    log_path.write_text("\n".join(log_lines) + "\n")

    if os.environ.get("FAKE_ARENA_RUN_JSON") != "0":
        (out / "run.json").write_text(
            '{"seed": %s, "map": "%s", "fake": true}\n'
            % (arg("--seed", "0"), arg("--map", "?"))
        )

    return int(os.environ.get("FAKE_ARENA_EXIT", "0"))


if __name__ == "__main__":
    sys.exit(main())
