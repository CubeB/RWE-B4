#ifndef RWE_CONFIG_H
#define RWE_CONFIG_H

#include <string>

namespace rwe
{
    static const std::string GitDescription("@RWE_GIT_DESCRIPTION@");
    static const std::string ProjectName("@PROJECT_NAME@");
    static const std::string ProjectBuildType("@CMAKE_BUILD_TYPE@");

    static const std::string ProjectNameVersion = ProjectName + " " + GitDescription + "-" + ProjectBuildType;

    /** This build's own number, shown under the main-menu title. */
    static const std::string RevivalVersion("1.0");

    /** "Bot bot boom boom" -- four B's, so B4 for short. */
    static const std::string RevivalTitle = "Bot bot boom boom v" + RevivalVersion;
}

#endif
