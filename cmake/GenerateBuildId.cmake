# Writes the file that says which commit this binary was built from.
#
#   cmake -DGIT_EXECUTABLE=<git> -DSOURCE_DIR=<repo> -DOUTPUT=<file.cpp> -P GenerateBuildId.cmake
#
# It runs on every build, not at configure time. `git describe` at configure
# time -- which is what config.h carries -- goes stale the moment a commit is
# made without CMake being re-run, and the answer to "are these two builds the
# same" has to be about the code that was compiled. The file is only written
# when its contents change, so a build that has not moved a commit costs one
# comparison and no recompile.

set(build_id "unknown")

if(GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE head
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE head_result
        ERROR_QUIET)

    if(head_result EQUAL 0 AND head MATCHES "^[0-9a-f]+$")
        set(build_id "${head}")

        # Source that is not what the commit says. Limited to the directories
        # that make the game: the submodules under libs/ report themselves
        # modified on a Windows checkout (line endings), and a build is not a
        # different build because of that.
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD -- src proto CMakeLists.txt cmake
            WORKING_DIRECTORY "${SOURCE_DIR}"
            RESULT_VARIABLE dirty_result
            ERROR_QUIET OUTPUT_QUIET)
        if(NOT dirty_result EQUAL 0)
            set(build_id "${head}-d")
        endif()
    endif()
endif()

set(content "// Generated by cmake/GenerateBuildId.cmake. Do not edit.\nnamespace rwe\n{\n    const char* generatedBuildIdentity();\n\n    const char* generatedBuildIdentity()\n    {\n        return \"${build_id}\";\n    }\n}\n")

set(existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
