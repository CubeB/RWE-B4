{
  "name": "rwe-launcher",
  "version": "0.1.0",
  "description": "Launcher application for Robot War Engine",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "run-p server master-server start",
    "build:main": "webpack --config webpack.main.config.js",
    "build:master": "webpack --config webpack.master.config.js",
    "build:renderer:dev": "cross-env RWE_LAUNCHER_IS_DEV=1 webpack --config webpack.renderer.config.js",
    "build:renderer:prod": "webpack --config webpack.renderer.config.js",
    "build:all:prod": "npm run build:master && npm run build:main && npm run build:renderer:prod",
    "build:all:dev": "npm run build:master && npm run build:main && npm run build:renderer:dev",
    "start": "npm run build:main && cross-env RWE_LAUNCHER_IS_DEV=1 electron ./dist/main.js",
    "server": "cross-env RWE_LAUNCHER_IS_DEV=1 webpack serve --config webpack.renderer.config.js",
    "master-server": "npm run build:master && node dist/master-server.js",
    "start:master": "node dist/master-server.js",
    "clean": "rm -rf ./dist",
    "package": "npm run build:all:prod && electron-packager dist --arch=x64 --overwrite --asar",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "tsc": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest"
  },
  "author": "Michael Heasell",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@storybook/react-webpack5": "^10.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-redux": "^7.1.34",
    "@types/react-window": "^1.8.8",
    "@types/winreg": "^1.2.36",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^44.4.5",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "react-refresh": "^0.19.0",
    "storybook": "^10.6.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@reduxjs/toolkit": "^1.9.7",
    "@sentry/electron": "^7.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-window": "^1.8.11",
    "redux": "^4.2.1",
    "redux-observable": "^2.0.0",
    "reselect": "^4.1.8",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "winreg": "^1.2.5",
    "yargs": "^18.2.0"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  }
}
